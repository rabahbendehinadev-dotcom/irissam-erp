# ─────────────────────────────────────────────────────────────────────────────
# IRISSAM Hospital ERP — Variables d'Environnement Production (VPS)
#
# Copier ce fichier en .env sur le VPS et remplir toutes les valeurs.
# NE JAMAIS commiter le fichier .env dans Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=irissam
POSTGRES_USER=irissam
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# URL complète (construite automatiquement par docker-compose à partir des vars ci-dessus)
# DATABASE_URL=postgresql://irissam:password@postgres:5432/irissam

# ── Sécurité / JWT ────────────────────────────────────────────────────────────
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64_random_bytes_hex
JWT_SECRET=CHANGE_ME_64_random_bytes_hex
JWT_REFRESH_SECRET=CHANGE_ME_64_random_bytes_hex

# ── Stockage local VPS ────────────────────────────────────────────────────────
# Ces variables sont fixées dans docker-compose.production.yml.
# NE PAS modifier sauf si vous changez la structure des volumes.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/app/storage
DOCUMENTS_DIR=/app/storage/documents
UPLOADS_DIR=/app/storage/uploads
PDF_DIR=/app/storage/pdfs
BACKUP_DIR=/app/storage/backups
MAX_DOC_FILE_SIZE=52428800

# ── CORS ──────────────────────────────────────────────────────────────────────
# Remplacer par le domaine réel du VPS
CORS_ORIGIN=https://votre-domaine.com

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Backup ────────────────────────────────────────────────────────────────────
# Utilisé par scripts/backup.sh
PGHOST=localhost
PGPORT=5432
# PGPASSWORD=idem POSTGRES_PASSWORD (ou utiliser ~/.pgpass)
RETENTION_DAYS=30
BACKUP_ROOT=/data/irissam/backups
